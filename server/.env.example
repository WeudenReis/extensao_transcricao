# ─── Google OAuth2 (obrigatório) ─────────────────────────────────────────────
# Client ID/Secret do tipo "Web application" criado no GCP (veja docs/SETUP-GCP.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Precisa estar cadastrado como "Authorized redirect URI" no OAuth Client do GCP.
GOOGLE_REDIRECT_URI=http://localhost:3333/oauth/callback

# ─── Workspace Events / Pub/Sub (opcional em dev, obrigatório pro pipeline) ──
# Tópico Pub/Sub que recebe os eventos do Meet (formato completo).
# Sem esse valor o servidor sobe, mas NÃO cria a subscription de eventos.
GOOGLE_PUBSUB_TOPIC=projects/SEU_PROJETO/topics/meet-events

# Audience configurada na push subscription do Pub/Sub (OIDC token).
# Se vazio, o webhook REJEITA todo push com 403 — exceto se
# ALLOW_INSECURE_PUBSUB=true (abaixo) estiver setada.
PUBSUB_VERIFICATION_AUDIENCE=

# E-mail do service account configurado na push subscription (--push-auth-service-account),
# ex.: pubsub-pusher@SEU_PROJETO.iam.gserviceaccount.com
# Com ele setado, o webhook exige que o OIDC token pertença EXATAMENTE a esse
# service account (email + email_verified). Vazio = aceita qualquer identity
# token do Google com a audience correta (com warning) — configure em produção.
PUBSUB_SERVICE_ACCOUNT=

# SOMENTE DESENVOLVIMENTO: "true" permite receber pushes SEM validação de OIDC
# (quando PUBSUB_VERIFICATION_AUDIENCE está vazia). Nunca usar em produção.
ALLOW_INSECURE_PUBSUB=

# ─── Voreo (plataforma de análise de reunião) ────────────────────────────────
# Se VOREO_WEBHOOK_URL ficar vazio, o payload é logado (resumido) e marcado
# como 'skipped-no-url' — útil pra testar o pipeline sem a Voreo pronta.
VOREO_WEBHOOK_URL=
VOREO_API_KEY=

# ─── STT — transcrição do áudio capturado (funciona em conta pessoal) ────────
# Provedor: local (padrão, 100% GRÁTIS e offline) | deepgram | assemblyai | whisper | none
#   local     = Whisper rodando na sua máquina (transformers.js). Sem conta, sem
#               chave, sem custo. Baixa o modelo uma vez (~465MB) e roda em CPU.
#   deepgram  = nuvem paga (pt-BR ótimo, crédito grátis inicial). Precisa STT_API_KEY.
#   whisper   = servidor Whisper local/externo compatível com OpenAI (STT_BASE_URL).
#   none      = só grava o áudio, não transcreve.
STT_PROVIDER=local
# Chave — SÓ pra deepgram/assemblyai (ou whisper externo autenticado). 'local' não usa.
STT_API_KEY=
# Modelo. local: Xenova/whisper-small (padrão) | Xenova/whisper-base (mais rápido)
#              | Xenova/whisper-tiny (rápido, menos preciso).
# deepgram: nova-3. whisper: whisper-1.
STT_MODEL=
# Idioma do áudio.
STT_LANGUAGE=pt-BR
# Só pra STT_PROVIDER=whisper (servidor Whisper compatível com OpenAI),
# ex.: http://localhost:8000/v1
STT_BASE_URL=
# Dias que o ÁUDIO bruto fica em disco antes do expurgo (o transcrito é mantido).
CAPTURE_RETENTION_DAYS=7
# Enviar automaticamente pra Voreo ao terminar? Padrão false: você revisa antes
# no painel (http://localhost:3333) e envia pelo botão.
AUTO_SEND_VOREO=

# ─── Recall.ai (bot que entra na reunião, grava e transcreve) ────────────────
# TODAS opcionais: sem elas o servidor sobe igual e só avisa no log o que falta.
#
# Chave da API do workspace (dashboard do Recall.ai, na região certa).
# Vai no header `Authorization: Token ...`. Sem ela, não dá pra criar bots.
RECALL_API_KEY=
# Região do workspace — a base da API muda junto: https://{regiao}.recall.ai/api/v1
# Valores: us-east-1 | us-west-2 | eu-central-1 | ap-northeast-1
# A nossa conta (pay-as-you-go) é us-west-2. Chave de uma região NÃO vale na outra.
RECALL_REGION=us-west-2
# Segredo do endpoint de webhook (Svix), começa com whsec_. É criado no dashboard
# junto com a URL de destino. Sem ele, o Recall NÃO manda os headers de assinatura
# e /webhooks/recall responde 403 — salvo ALLOW_INSECURE_RECALL=true.
RECALL_WEBHOOK_SECRET=
# Nome que o bot exibe como participante na reunião (fica visível pro cliente —
# é o que torna a gravação evidente e consentida).
RECALL_BOT_NAME=chatPro (gravando)
# SOMENTE DESENVOLVIMENTO: "true" aceita webhooks SEM verificar a assinatura
# (quando RECALL_WEBHOOK_SECRET está vazio). Nunca usar em produção.
ALLOW_INSECURE_RECALL=
# URL pública HTTPS deste backend (túnel ngrok/Cloudflare ou hospedagem),
# ex.: https://seu-tunel.ngrok.app — é onde o Recall entrega os webhooks.
# Cadastre `{PUBLIC_BASE_URL}/webhooks/recall` no dashboard.
PUBLIC_BASE_URL=

# ─── chatPro (entrega final da transcrição) ──────────────────────────────────
# Endpoint do chatPro que recebe {sessionId, transcript, metadados}.
# Vazio = a entrega é marcada como 'skipped-no-url' (modo dev, sem tocar a rede).
CHATPRO_API_URL=
# Autenticação junto ao chatPro (enviada como Bearer).
CHATPRO_API_KEY=
# Enviar automaticamente ao terminar a reunião? Padrão false: revisa no painel
# e envia pelo botão.
AUTO_SEND_CHATPRO=

# ─── Tranca do painel (OBRIGATÓRIA se o servidor for exposto) ────────────────
# Pro Recall entregar os webhooks, este servidor precisa estar acessível por
# HTTPS público — e o túnel publica o app INTEIRO, não só /webhooks/recall.
# Sem esta chave, quem descobrir a URL lê a transcrição das reuniões (nome e
# e-mail dos participantes) e cria bots, que são cobrados por hora.
#
# Gere uma: openssl rand -hex 24    (mínimo 16 caracteres)
# Depois abra o painel uma vez com http://localhost:3333/?token=SEU_TOKEN —
# ele guarda num cookie e você não precisa repetir.
#
# /webhooks/* e /api/capture/* ficam livres de propósito: o webhook se
# autentica por assinatura própria, e a extensão só escreve (não lê nada).
# Vazio = tudo aberto, com aviso no boot. Só pra dev em localhost.
PANEL_TOKEN=

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3333
DATABASE_PATH=./data/app.db

# Chave usada pra cifrar o refresh token do Google (AES-256-GCM).
# Qualquer string longa e aleatória serve (ex.: saída de `openssl rand -hex 32`).
# Se vazio, o token é salvo em texto puro com warning claro (apenas dev).
TOKEN_ENCRYPTION_KEY=
