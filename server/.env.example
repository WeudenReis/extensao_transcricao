# ─── Google OAuth2 (obrigatório) ─────────────────────────────────────────────
# Client ID/Secret do tipo "Web application" criado no GCP (veja docs/SETUP-GCP.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Precisa estar cadastrado como "Authorized redirect URI" no OAuth Client do GCP.
GOOGLE_REDIRECT_URI=http://localhost:3333/oauth/callback

# ─── Workspace Events / Pub/Sub (opcional em dev, obrigatório pro pipeline) ──
# Tópico Pub/Sub que recebe os eventos do Meet (formato completo).
# Sem esse valor o servidor sobe, mas NÃO cria a subscription de eventos.
GOOGLE_PUBSUB_TOPIC=projects/SEU_PROJETO/topics/meet-events

# Audience configurada na push subscription do Pub/Sub (OIDC token).
# Se vazio, o webhook REJEITA todo push com 403 — exceto se
# ALLOW_INSECURE_PUBSUB=true (abaixo) estiver setada.
PUBSUB_VERIFICATION_AUDIENCE=

# E-mail do service account configurado na push subscription (--push-auth-service-account),
# ex.: pubsub-pusher@SEU_PROJETO.iam.gserviceaccount.com
# Com ele setado, o webhook exige que o OIDC token pertença EXATAMENTE a esse
# service account (email + email_verified). Vazio = aceita qualquer identity
# token do Google com a audience correta (com warning) — configure em produção.
PUBSUB_SERVICE_ACCOUNT=

# SOMENTE DESENVOLVIMENTO: "true" permite receber pushes SEM validação de OIDC
# (quando PUBSUB_VERIFICATION_AUDIENCE está vazia). Nunca usar em produção.
ALLOW_INSECURE_PUBSUB=

# ─── Voreo (plataforma de análise de reunião) ────────────────────────────────
# Se VOREO_WEBHOOK_URL ficar vazio, o payload é logado (resumido) e marcado
# como 'skipped-no-url' — útil pra testar o pipeline sem a Voreo pronta.
VOREO_WEBHOOK_URL=
VOREO_API_KEY=

# ─── STT — transcrição do áudio capturado (funciona em conta pessoal) ────────
# Provedor: deepgram (padrão) | assemblyai | whisper | none
# 'none' ou sem STT_API_KEY = grava o áudio mas NÃO transcreve (modo dev).
STT_PROVIDER=deepgram
# Chave do provedor. Deepgram: crie grátis em https://console.deepgram.com (crédito inicial).
STT_API_KEY=
# Modelo (opcional). Deepgram default: nova-3. Whisper: whisper-1.
STT_MODEL=
# Idioma do áudio.
STT_LANGUAGE=pt-BR
# Só pra STT_PROVIDER=whisper (servidor Whisper local compatível com OpenAI),
# ex.: http://localhost:8000/v1
STT_BASE_URL=
# Dias que o ÁUDIO bruto fica em disco antes do expurgo (o transcrito é mantido).
CAPTURE_RETENTION_DAYS=7
# Enviar automaticamente pra Voreo ao terminar? Padrão false: você revisa antes
# no painel (http://localhost:3333) e envia pelo botão.
AUTO_SEND_VOREO=

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3333
DATABASE_PATH=./data/app.db

# Chave usada pra cifrar o refresh token do Google (AES-256-GCM).
# Qualquer string longa e aleatória serve (ex.: saída de `openssl rand -hex 32`).
# Se vazio, o token é salvo em texto puro com warning claro (apenas dev).
TOKEN_ENCRYPTION_KEY=
