{
  "manifest_version": 3,
  "name": "chatPro Meet Transcripts",
  "version": "0.1.0",
  "description": "Vincula a conversa ativa do chatPro com a reunião do Google Meet para juntar a transcrição automaticamente.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": [
    "https://app.chatpro.com.br/*",
    "https://meet.google.com/*",
    "http://localhost:3333/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.chatpro.com.br/*"],
      "js": ["content/chatpro.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/meet.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "chatPro Meet Transcripts",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
