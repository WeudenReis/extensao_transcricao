{
  "manifest_version": 3,
  "name": "chatPro Reuniões",
  "version": "3.2.0",
  "description": "Botão de reunião no chatPro: abre a aba lateral pra marcar agora ou agendar, manda o link pro cliente e grava a chamada.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://app.chatpro.com.br/*",
    "http://localhost:3333/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.chatpro.com.br/*"
      ],
      "js": [
        "content/atendente.js",
        "content/aba-reuniao.js",
        "content/fluxo-reuniao.js",
        "content/botao-reuniao.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "chatPro Reuniões",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
